{
  "name": "@nuvix/storage",
  "version": "2.0.0",
  "description": "S3-compatible storage library for the Nuvix BaaS platform, built on Bun's native APIs. Supports AWS S3, Wasabi, MinIO, and local storage.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./index.ts --outdir dist --target bun --format esm --minify",
    "build:types": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint src __tests__ index.ts",
    "lint:fix": "oxlint src __tests__ index.ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "nuvix",
    "storage",
    "s3",
    "baas",
    "wasabi",
    "minio",
    "cloud-storage",
    "file-upload",
    "typescript",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "bun": ">=1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nuvix-tech/storage.git"
  },
  "bugs": {
    "type": "git",
    "url": "https://github.com/nuvix-tech/storage/issues"
  },
  "homepage": "https://github.com/nuvix-tech/storage#readme"
}
